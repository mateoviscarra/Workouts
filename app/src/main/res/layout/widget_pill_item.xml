<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_pill_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_pill_row_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <FrameLayout
        android:layout_width="22dp"
        android:layout_height="22dp">

        <ImageView
            android:id="@+id/widget_pill_circle"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Status"
            android:src="@drawable/widget_check_circle_pending" />

        <ImageView
            android:id="@+id/widget_pill_check_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:contentDescription="Taken"
            android:src="@drawable/ic_widget_check"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_pill_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Creatine"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_pill_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="4g • 07:30"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_pill_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_badge_pending"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="Take"
        android:textColor="@color/widget_on_primary_container"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
